n = size(city,1);

% 距离距离

dist = zeros(n);

for i = 1:n
    for j = 1:n
        dist(i,j) = norm(city(i,:) - city(j,:));
    end
end

% 参数设置

popSize = 100;      % 种群规模
maxGen = 500;       % 最大代数

Pc = 0.9;           % 交叉概率
Pm = 0.2;           % 变异概率

eliteNum = 2;       % 精英保留数

% 初始化种群

pop = zeros(popSize,n);

for i = 1:popSize
    pop(i,:) = randperm(n);
end

bestHistory = zeros(maxGen,1);

% 主循环

for gen = 1:maxGen

    %% 计算适应度

    fit = zeros(popSize,1);

    for i = 1:popSize
        fit(i) = pathLength(pop(i,:),dist);
    end

    %% 最优个体

    [bestFit,index] = min(fit);

    bestPath = pop(index,:);

    bestHistory(gen) = bestFit;

    fprintf('第 %d 代: %.2f\n',gen,bestFit);

    % 精英保留

    [~,sortIndex] = sort(fit);

    newPop = pop(sortIndex(1:eliteNum),:);

    % 生成新种群

    while size(newPop,1) < popSize

        %% 选择

        p1 = tournamentSelection(pop,fit);
        p2 = tournamentSelection(pop,fit);

        %% 交叉

        if rand < Pc
            [c1,c2] = OX(p1,p2);
        else
            c1 = p1;
            c2 = p2;
        end

        %% 变异

        if rand < Pm
            c1 = mutation(c1);
        end

        if rand < Pm
            c2 = mutation(c2);
        end

        %% 加入新种群

        newPop = [newPop; c1];

        if size(newPop,1) < popSize
            newPop = [newPop; c2];
        end

    end

    %% 更新种群

    pop = newPop;

end

