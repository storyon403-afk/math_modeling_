% 函数部分

function L = pathLength(path,dist)

n = length(path);

L = 0;

for i = 1:n-1
    L = L + dist(path(i),path(i+1));
end

L = L + dist(path(n),path(1));

end


% 锦标赛选择

function parent = tournamentSelection(pop,fit)

k = 4;

idx = randperm(size(pop,1),k);

candidateFit = fit(idx);

[~,best] = min(candidateFit);

parent = pop(idx(best),:);

end

% OX顺序交叉

function [c1,c2] = OX(p1,p2)

n = length(p1);

a = randi([1,n-1]);
b = randi([a+1,n]);

c1 = zeros(1,n);
c2 = zeros(1,n);

%% 保留片段

c1(a:b) = p1(a:b);
c2(a:b) = p2(a:b);

%% 填充c1

remain = p2(~ismember(p2,c1));

index = [b+1:n 1:a-1];

c1(index) = remain;

%% 填充c2

remain = p1(~ismember(p1,c2));

c2(index) = remain;

end

% 交换变异

function child = mutation(child)

n = length(child);

i = randi(n);
j = randi(n);

temp = child(i);

child(i) = child(j);

child(j) = temp;

end